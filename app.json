{
  "expo": {
    "name": "Coach imi",
    "slug": "yazio-klon",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "yazioklon",
    "userInterfaceStyle": "automatic",
    "ios": {
      "icon": "./assets/expo.icon"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#22c55e",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ],
      [
        "expo-camera",
        {
          "cameraPermission": "Die Kamera wird verwendet, um Barcodes von Lebensmitteln zu scannen."
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Der Fotozugriff wird verwendet, um Mahlzeiten-Fotos für die KI-Nährwertanalyse auszuwählen.",
          "cameraPermission": "Die Kamera wird verwendet, um Fotos von Mahlzeiten für die KI-Nährwertanalyse aufzunehmen."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
